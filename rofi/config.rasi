configuration {
    show-icons:      true;
    display-drun:    "";
    drun-display-format: "{name}";
}

@import "/home/nightmare/.cache/wal/colors-rofi-opaq.rasi"
//@import "/home/nightmare/.cache/wal/colors-rofi-dark.rasi"

/* 2. Map the variables so the template knows what bg0, bg1, etc. are */
* {
    font: "JetBrainsMono Nerd Font Propo 12";
    /* Backgrounds */
    bg0: @background;
    bg1: @background;                 /* Input bar background */
    bg2: @alternate-normal-background; /* Message background */
    bg3: @selected-normal-background;  /* Selection highlight (The Accent) */

    /* Foregrounds */
    fg0: @foreground;
    fg1: @foreground;
    fg2: @foreground;
    fg3: @foreground;                  /* Placeholder text */

  
    /*font: "Roboto 12";*/

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       north;
    y-offset:       calc(50% - 176px);
    width:          480;
    border-radius:  24px;

    background-color:   @bg0;


}

mainbox {
    padding:    12px;
}

inputbar {
    background-color:   @bg1;
    border-color:       @bg3;

    border:         2px;
    border-radius:  16px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ entry ];
}

prompt {
    text-color: @fg2;
}

entry {
    placeholder:        "Search";
    placeholder-color:  @fg3;
}

message {
    margin:             12px 0 0;
    border-radius:      16px;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    margin:     12px 0 0;
    lines:      8;
    columns:    1;

    fixed-height: false;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  16px;
}

element normal active {
    text-color: @bg3;
}

element alternate active {
    text-color: @bg3;
}

element selected normal, element selected active {
    background-color:   @bg3;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}

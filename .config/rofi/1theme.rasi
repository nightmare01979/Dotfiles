* {
    /* These variable names match exactly what Pywal generates */
    bg-col:  @background;
    border-col: @color1;
    selected-col: @color2;
    fg-col: @foreground;

    width: 600;
    font: "JetBrainsMono Nerd Font 12";
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 360px;
    border: 3px;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 12px;
}

mainbox {
    background-color: transparent;
}

inputbar {
    children: [prompt,entry];
    background-color: transparent;
    padding: 10px;
}

prompt {
    background-color: @selected-col;
    padding: 6px;
    text-color: @bg-col;
    border-radius: 3px;
    margin: 0px 10px 0px 0px;
}

entry {
    padding: 6px;
    text-color: @fg-col;
    background-color: transparent;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 10px 0px 0px 10px;
    columns: 2;
    lines: 5;
    background-color: transparent;
}

element {
    padding: 5px;
    background-color: transparent;
    text-color: @fg-col;
}

element selected {
    background-color:  @selected-col;
    text-color: @bg-col;
    border-radius: 3px;
}

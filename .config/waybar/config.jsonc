{
    "layer": "top",
    "position": "top",
    "on-scroll-up": "true",
    "on-scroll-down": "true",
    "reload_style_on_change": true,
    "modules-left": ["clock"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["group/gleft2"],

    "hyprland/workspaces": {
        "persistent-workspaces": {
            "*": [ 1,2,3,4,5 ]
        }
    },

    "group/gleft2" : {
        "orientation": "horizontal",
        "modules" : [
            "wireplumber","bluetooth","custom/power"
        ],
        "on-scroll-up": {},     
        "on-scroll-down": {}  
    }, 

    "wireplumber":{
        "format":" {volume}%",
        "format-muted":" {volume}%",
        "tooltip":false,
        "on-click":"wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "custom/power": {
        "format": "",
        "on-click": "wlogout --buttons-per-row 2",
        "on-click-right": "systemctl lock-session",
        "on-scroll-up": {},    
        "on-scroll-down": {},
	"tooltip":false
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "interval": 1,
        "tooltip":false
    },

    "bluetooth": {
        "format": "{}",
        "format-on": "",
        "format-off": "󰂲",
        "format-disabled" : "󰂲",
        "format-connected" : "󰂰",
        "tooltip-format": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t {device_battery_percentage}%",
        "on-click": "exec blueman-manager",
        "on-scroll-up": {},  
        "on-scroll-down": {}  
    }



// endline
} 

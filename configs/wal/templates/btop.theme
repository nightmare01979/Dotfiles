# Auto-generated btop theme via pywal

theme[main_bg]="${background}"
theme[main_fg]="${foreground}"

theme[title]="${color4}"
theme[hi_fg]="${color1}"

theme[selected_bg]="${color2}"
theme[selected_fg]="${background}"

theme[inactive_fg]="${color8}"

# CPU
theme[cpu_box]="${color4}"
theme[cpu_text]="${foreground}"
theme[cpu_graph]="${color2}"

# Memory
theme[mem_box]="${color5}"
theme[mem_text]="${foreground}"
theme[mem_graph]="${color3}"

# Network
theme[net_box]="${color6}"
theme[net_text]="${foreground}"
theme[net_graph]="${color1}"

# Processes
theme[proc_box]="${color4}"
theme[proc_text]="${foreground}"

# Misc
theme[border]="${color8}"
theme[div_line]="${color8}"
